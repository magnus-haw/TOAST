# =============================================================================
# Python
# =============================================================================

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Compiled extensions
*.so
*.dylib

# Distribution / packaging
build/
dist/
downloads/
.eggs/
*.egg-info/
*.egg
MANIFEST

# Editable-install artifacts
src/*.egg-info/
src/**/*.egg-info/


# =============================================================================
# Python environments
# =============================================================================

.venv/
venv/
env/
ENV/

# Conda environments should normally live outside the repository, but ignore
# these if one is created locally.
.conda/
conda-env/

# Environment-variable files
.env
.env.*
!.env.example


